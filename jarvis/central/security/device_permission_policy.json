{
  "version": 1,
  "name": "JARVIS Authorized Device Policy",

  "allowed_capabilities": [
    "open_app",
    "open_url",
    "device_info",
    "notifications",
    "bluetooth",
    "location",
    "authorized_files",
    "tts",
    "vibration"
